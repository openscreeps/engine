{
  "name": "@openscreeps/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable, typed Screeps-compatible simulation engine",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "reference-versions.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/**/*.test.ts",
    "conformance:setup": "node conformance/setup.mjs",
    "conformance": "node conformance/runtime.mjs && node conformance/simulation.mjs --allow-known-divergences",
    "conformance:controlled": "node conformance/runtime.mjs && node conformance/simulation.mjs --controlled-order --allow-known-divergences",
    "conformance:strict": "node conformance/runtime.mjs && node conformance/simulation.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "dependencies": {
    "buffer": "4.9.2",
    "esbuild": "0.28.2",
    "isolated-vm": "7.0.1",
    "lodash": "3.10.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "isolated-vm@7.0.1": true
  }
}
